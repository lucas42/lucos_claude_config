# Ignore everything by default — this is a public repo and ~/.claude contains
# volatile runtime data and potentially sensitive config (history, session state,
# MCP server settings, etc).
*
.*

# Explicitly track these safe files:
!.gitignore
!CLAUDE.md
!pr-review-loop.md
!python-testing.md

# Claude Code settings (non-sensitive configuration only)
!settings.json

# Agent persona definitions
!agents/
!agents/**

# Custom slash command skills
!skills/
!skills/**

# Architecture Decision Records
!docs/
!docs/**

# Agent persistent memory
!agent-memory/
!agent-memory/**

# Dispatcher auto-memory (project-scoped persistent memory).
# Track only the memory/ subdirectory — NOT session history, tool results, or
# subagent logs, which live alongside it and must not go into a public repo.
!projects/
!projects/*/
!projects/*/CLAUDE.md
!projects/*/memory/
!projects/*/memory/**

# Infrastructure scripts
!scripts/
!scripts/**
# ...but not log files generated at runtime
scripts/*.log
# ...and not return-to-main.sh's persistent-dirt tracking state (lucos_claude_config#129)
scripts/.return-to-main-dirty-since

# GitHub Actions workflows and other repo config
!.github/
!.github/**

# Team config — track config.canonical.json (stripped of runtime state) not config.json
# (config.json is overwritten by Claude Code each session with timestamps, session IDs, etc.)
!teams/
!teams/*/
!teams/*/config.canonical.json

# Infrastructure and convention reference files
!references/
!references/**

# Atomic-write scratch files: Write/Edit writes "<name>.tmp.<pid>.<hash>" next
# to its target and renames it into place. The window where the temp file
# genuinely exists on disk can't be closed from this side, but it doesn't need
# to be visible to git — this pattern is placed last, after every allowlist
# re-include above, so it wins even inside e.g. agent-memory/**. Same pattern
# commit-agent-memory.sh already strips defensively before staging (added
# after two of these got committed for real: 6af519e, dc79389) — this is the
# other half of that fix: that stops them being committed, this stops them
# being seen. lucos_claude_config#129.
*.tmp.[0-9]*.*

.DS_Store

