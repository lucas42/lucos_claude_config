#!/bin/bash
# Lists EVERY issue in the "Ready" column of the "lucOS Issue Prioritisation"
# project board, in board position order (top of the column first).
#
# Companion to get-next-implementation-issue, which returns only the first one.
# Used by the /unattended skill to enumerate dispatch candidates.
#
# Usage: list-ready-issues [--json]
#
#   (default)  human-readable table, one line per item, board order
#   --json     JSON array, board order, one object per item
#
# Fields per item: position (1-based board order within Ready), repo, number,
# title, url, owner, priority.
#
# Items with Status = Ready but NO owner are still listed, with owner "" —
# the caller must treat an unowned item as not dispatchable (untriaged) rather
# than guessing an owner. This is deliberately different from
# get-next-implementation-issue, which silently skips them: a sweep needs to
# report the mis-triage, not hide it.
#
# PAGINATES. The GraphQL items connection caps at 100 per page and the board
# passed 100 items some time before 2026-08-23 (147 that day). A single
# first:100 page silently drops everything past position 100 — and because
# addProjectV2ItemById appends to the BOTTOM, the dropped items are exactly the
# newly-filed ones. Nothing errors; the result just quietly answers a narrower
# question than the one asked. Every page is fetched and the total is asserted
# against the connection's own totalCount before any output is produced.
#
# Authentication: uses gh-projects (GITHUB_PROJECTS_PAT) — GitHub Apps cannot
# access v2 user projects.

set -euo pipefail

FORMAT="table"
if [ $# -gt 0 ]; then
    case "$1" in
        --json) FORMAT="json" ;;
        --help|-h) sed -n '2,30p' "$0"; exit 0 ;;
        *) echo "Usage: list-ready-issues [--json]" >&2; exit 2 ;;
    esac
fi

SCRIPT_DIR="$HOME/sandboxes/lucos_agent"

TMPDIR_PAGES=$(mktemp -d)
trap 'rm -rf "$TMPDIR_PAGES"' EXIT

CURSOR=""
PAGE=0
while :; do
    PAGE=$((PAGE + 1))
    if [ -z "$CURSOR" ]; then
        AFTER="null"
    else
        AFTER="\"$CURSOR\""
    fi

    "$SCRIPT_DIR/gh-projects" graphql -f query="
{
  node(id: \"PVT_kwHOAAaLL84BRh5d\") {
    ... on ProjectV2 {
      items(first: 100, after: $AFTER, orderBy: {field: POSITION, direction: ASC}) {
        totalCount
        pageInfo { hasNextPage endCursor }
        nodes {
          content {
            ... on Issue {
              number
              title
              url
              state
              labels(first: 20) { nodes { name } }
            }
          }
          fieldValues(first: 20) {
            nodes {
              ... on ProjectV2ItemFieldSingleSelectValue {
                name
                field { ... on ProjectV2SingleSelectField { name } }
              }
            }
          }
        }
      }
    }
  }
}" > "$TMPDIR_PAGES/page-$(printf '%03d' "$PAGE").json"

    HAS_NEXT=$(python3 -c "
import json,sys
d=json.load(open(sys.argv[1]))['data']['node']['items']['pageInfo']
print('yes' if d['hasNextPage'] else 'no')
print(d['endCursor'] or '')
" "$TMPDIR_PAGES/page-$(printf '%03d' "$PAGE").json")

    CURSOR=$(printf '%s' "$HAS_NEXT" | sed -n '2p')
    if [ "$(printf '%s' "$HAS_NEXT" | sed -n '1p')" != "yes" ]; then
        break
    fi
    if [ "$PAGE" -ge 50 ]; then
        echo "ERROR: pagination exceeded 50 pages — aborting rather than truncating" >&2
        exit 2
    fi
done

_PAGEDIR="$TMPDIR_PAGES" _FORMAT="$FORMAT" python3 << 'PYEOF'
import glob, json, os, re, sys

nodes = []
total_count = None
for path in sorted(glob.glob(os.path.join(os.environ["_PAGEDIR"], "page-*.json"))):
    with open(path) as f:
        conn = json.load(f)["data"]["node"]["items"]
    if total_count is None:
        total_count = conn["totalCount"]
    nodes.extend(conn["nodes"])

# Assert we actually got everything. A short read here is the exact failure this
# script exists to prevent, so fail loudly rather than emit a partial list.
if total_count is not None and len(nodes) != total_count:
    sys.exit(
        f"ERROR: fetched {len(nodes)} board items but totalCount is {total_count} — "
        "refusing to emit a truncated list"
    )


def fields_of(node):
    out = {}
    for fv in node.get("fieldValues", {}).get("nodes", []):
        if fv and "field" in fv and "name" in fv:
            out[fv["field"]["name"]] = fv["name"]
    return out


items = []
for node in nodes:
    content = node.get("content")
    if not content or "url" not in content:
        continue  # draft issues / PRs
    fields = fields_of(node)
    if fields.get("Status") != "Ready":
        continue
    if content.get("state") == "CLOSED":
        continue

    owner = fields.get("Owner", "")
    if not owner:
        labels = [l["name"] for l in content.get("labels", {}).get("nodes", [])]
        owner_labels = [l for l in labels if l.startswith("owner:")]
        if owner_labels:
            owner = owner_labels[0].removeprefix("owner:")

    m = re.match(r"https://github\.com/([^/]+)/([^/]+)/issues/(\d+)", content["url"])
    items.append({
        "position": len(items) + 1,
        "repo":     m.group(2) if m else "",
        "number":   content["number"],
        "title":    content["title"],
        "url":      content["url"],
        "owner":    owner,
        "priority": fields.get("Priority", ""),
        "labels":   [l["name"] for l in content.get("labels", {}).get("nodes", [])],
    })

if os.environ["_FORMAT"] == "json":
    print(json.dumps(items, indent=2))
else:
    if not items:
        print("No issues in the Ready column.")
        sys.exit(0)
    print(f"# {len(items)} Ready of {total_count} board items", file=sys.stderr)
    for i in items:
        print(f"{i['position']:>3}. {i['repo']}#{i['number']}  "
              f"[owner: {i['owner'] or 'UNSET'}] [priority: {i['priority'] or 'unset'}]  {i['title']}")
        print(f"     {i['url']}")
PYEOF
